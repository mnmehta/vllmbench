  "schemaVersion": 38,
  "style": "dark",
  "tags": ["dcgm", "gpu", "sm", "occupancy"],
  "templating": {
    "list": [
      {
        "name": "cluster_name",
        "type": "query",
        "label": "Cluster",
        "hide": 0,
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(vllm:prompt_tokens_total, cluster)",
        "query": { "query": "label_values(vllm:prompt_tokens_total, cluster)", "refId": "Prometheus-Variable-Query" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
