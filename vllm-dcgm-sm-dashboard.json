        {
          "expr": "DCGM_FI_PROF_SM_OCCUPANCY{cluster=~\"$cluster_name\"}",
          "legendFormat": "GPU {{gpu}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },
    {
      "type": "row",
